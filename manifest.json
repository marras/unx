{
	"manifest_version": 3,
	"name": "un-X",
	"version": "1.0.0",
	"description": "Redirect links using your own source and destination hosts.",
	"permissions": ["storage", "webRequest", "webRequestBlocking", "webNavigation"],
	"background": {
		"scripts": ["rules.js", "background.js"]
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"page_action": {
		"default_icon": { "48": "icons/unx-48.png", "96": "icons/unx-96.png" },
		"default_title": "Redirected by un-X — click to open the original site"
	},
	"host_permissions": ["<all_urls>"],
	"browser_specific_settings": {
		"gecko": {
			"id": "unx@marek",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": ["browsingActivity"]
			}
		}
	},
	"icons": {
		"48": "icons/unx-48.png",
		"96": "icons/unx-96.png"
	}
}
