{
	"manifest_version": 3,
	"name": "unxcom",
	"version": "0.1.0",
	"description": "Redirect links using your own source and destination hosts.",
	"permissions": ["storage", "webNavigation"],
	"background": {
		"scripts": ["rules.js", "background.js"]
	},
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["rules.js", "content.js"],
			"run_at": "document_start",
			"all_frames": true
		}
	],
	"host_permissions": ["<all_urls>"]
}
